# Pinned to the SAME digest as the production Dockerfile, deliberately.
# tag: node:22-alpine · Node 22.23.2 (Alpine) · resolved 2026-09-21
#
# Dev drifting off prod's base is how "works on devel" stops meaning anything: the whole value of
# this image is that it is the production one with a bind mount and a watcher, and a floating tag
# quietly erodes that the first time the upstream tag moves. Bump this and app/Dockerfile and
# web/Dockerfile together, or do not bump it.
FROM node:22-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85

# python3/make/g++ for native deps; fontconfig + DejaVu so sharp can rasterise text
# (make-og.mjs); ffmpeg for the slideshow export.
RUN apk add --no-cache python3 make g++ fontconfig ttf-dejavu ffmpeg

WORKDIR /app

# Root build context (see shared/README.md), so the path is prefixed.
COPY app/package*.json ./
RUN npm install && npm cache clean --force

# src/ AND /shared are bind-mounted at runtime — not copied here, so an edit to either is live
ENV NODE_ENV=development \
    PORT=3000 \
    DATA_DIR=/data

EXPOSE 3000

CMD ["npm", "start"]
