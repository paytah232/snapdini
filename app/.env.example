# Snapdini env — copy to `.env` in the same folder as your compose file and fill in.
# docker compose auto-loads ./.env for ${VAR} interpolation. `.env` is gitignored; this
# example is committed. Minimum to start: BASE_URL + POSTGRES_PASSWORD.

# ── Image / runtime (docker-compose.yml runs the published images) ──
# IMAGE_PREFIX=ghcr.io/paytah232/snapdini               # registry/namespace; change to use your own
# IMAGE_TAG=latest                                       # pin a release, e.g. 1.0.0 (recommended in prod)
# HTTP_PORT=8080                                         # host port nginx publishes (put TLS/proxy in front)

# ── Analytics / ads (optional; empty = NO tracking at all) ──
# Your Google tag id (e.g. AW-XXXXXXXXX for Ads, G-XXXXXXX for GA4). Leave unset and the app loads no
# third-party scripts. When set, Google Consent Mode v2 ships with it and EEA/UK visitors get a
# consent banner (defaults to denied there until they opt in). Region detection uses Cloudflare's
# CF-IPCountry header, so it works best behind Cloudflare.
# GTAG_ID=
# Google Ads purchase-conversion label — the part AFTER the "/" in the conversion's send_to
# (e.g. send_to "AW-123/AbC-D_efG" ⇒ label "AbC-D_efG"). Set it to fire a purchase conversion (with
# the real amount charged) when a paid event / upgrade / add-on completes. Unset ⇒ no conversions.
# GADS_PURCHASE_LABEL=
# Funnel (lead) conversion labels — fire when someone signs up / creates an event. Same format as
# above (the part after the "/" in each conversion's send_to). Unset ⇒ that conversion is off.
# GADS_SIGNUP_LABEL=
# GADS_CREATE_LABEL=
# Comma-separated emails whose signed-in sessions never fire conversions (site admins are always
# excluded) — so your own testing doesn't pollute the ad data.
# ANALYTICS_EXCLUDE_EMAILS=

# ── Core ──
# BASE_URL is REQUIRED in production. It's the public URL used for QR codes, email/verify
# links, Stripe redirects + webhook, and OG tags. In prod the app refuses to trust the
# request Host header for these (anti host-header-poisoning), so if BASE_URL is unset it
# logs a security warning and falls back to the host. Set it to YOUR public https URL.
# Local default below matches docker-compose.yml's HTTP_PORT (8080).
BASE_URL=http://localhost:8080

# ── Database ──
# Password for the bundled Postgres (the compose file wires this into DATABASE_URL for you).
# Change it before any real deployment.
POSTGRES_PASSWORD=change-me-to-a-strong-password
# DATABASE_URL=                                         # override only if using an external Postgres

# RETENTION_DAYS=7
# # How long a guest may take back a shot they just took, refunding the frame (default 60s).
# Keep it SHORT: a long window turns a limited roll into unlimited retries.
# Guest self-upgrade: one flat top-up, deliberately not a ladder — someone standing at a party with
# an empty roll should not be handed a pricing decision. Below about A$2 most of it is Stripe's
# fixed fee. The cutoff closes sales near the end of an event, when shots bought are worthless and
# come straight back as a refund request.
# Face matching ("find the photos I'm in"). UNSET = the feature does not exist, which is the right
# default: it processes biometric data and needs explicit consent plus a privacy policy that says so.
# Point it at an Immich machine-learning container (image bytes over HTTP, no volume mounts needed):
#   MACHINE_LEARNING_URL=http://<host>:3003
# Keep it in the same country as your users — running inference offshore is a cross-border disclosure.
MACHINE_LEARNING_URL=
FACE_MATCH_THRESHOLD=
FACE_MIN_SCORE=
FACE_TIMEOUT_MS=

GUEST_SHOT_PACK=
GUEST_SHOT_PACK_CENTS=
GUEST_UPGRADE_CUTOFF_MINUTES=

PHOTO_DELETE_WINDOW_SECONDS=

VIDEO_MAX_SECONDS=60                                   # global video length when billing is OFF
# MAX_FILE_SIZE_MB=64                                    # per-photo upload cap (an 8K still at max quality)
# MAX_VIDEO_SIZE_MB=8192                                 # per-video upload cap (8192 = plan for 90s 8K)
# IMAGE_CONCURRENCY=                                     # parallel image-processing jobs (default = vCPU-1)
# IMAGE_QUALITY=100                                      # stored-photo JPEG quality 1–100 (default 100 = max).
#   100 = full quality, 4:4:4 (largest files). Drop to ~95/90/85 for much smaller files: <90 also
#   switches to 4:2:0 + mozjpeg for bigger savings. Full resolution is always kept (never downscaled).
#   NB: a reverse proxy in front (nginx/Traefik) must also allow large bodies — see app/nginx/default.conf
#   (client_max_body_size + proxy_request_buffering off + long proxy timeouts).

# ── Media storage (ZFS pool) ──
# UPLOADS_HOST=/bigdata/snapdini/dev                     # host dir for photos/videos (default set in compose)

# ── Email (pick ONE; Mailgun preferred when set) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Snapdini <noreply@yourdomain.com>
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_BASE=https://api.mailgun.net                  # EU: https://api.eu.mailgun.net
# SUPPORT_EMAIL=support@yourdomain.com                  # contact-form recipient (unset = contact form stores only)

# ── Lifecycle & operator emails (optional; need email configured above) ──
# LIFECYCLE_EMAILS=1                                     # customer welcome / activation nudge / check-in / post-event survey
# OPS_NOTIFICATIONS=1                                    # digest + instant alerts to SUPPORT_EMAIL (unhappy survey, error spike)
# OPS_TZ=Australia/Brisbane                              # timezone for the digest hour + operator-facing times
# OPS_DIGEST_HOUR=8                                      # local hour to send the daily digest (silent when nothing pending)
# OPS_ERROR_SPIKE=20                                     # client-side errors in an hour that trigger a spike alert

# ── Site admin (both unset = no admin account; no shipped default credential) ──
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=change-me-strong        # only used to create the admin the first time

# ── Google sign-in (optional; both unset = Google button hidden) ──
# Create credentials at https://console.cloud.google.com/apis/credentials :
#   1) Create OAuth client ID → type "Web application".
#   2) Authorised redirect URI = <BASE_URL>/api/auth/google/callback
#      (e.g. https://yourdomain.com/api/auth/google/callback — must match BASE_URL exactly).
#   3) Copy the Client ID + Client secret here. (CSRF 'state' is handled automatically.)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Billing (Stripe) — set these to switch billing ON. Leave blank = self-host/free, no Pro UI. ──
# 1) Stripe Dashboard → Developers → API keys (TEST mode) → copy "Secret key":
STRIPE_SECRET_KEY=
# 2) Stripe Dashboard → Developers → Webhooks → Add endpoint:
#       URL    = <your BASE_URL>/api/billing/webhook
#       Events = checkout.session.completed
#    Then reveal the endpoint's "Signing secret" (whsec_...) and paste it here:
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=usd                                    # ISO currency for prices (e.g. usd, aud, eur, gbp)

# ── Cloudflare Turnstile (bot check on contact / register / login) ──────────────────────────
# Both unset = feature off entirely (self-host default). The SITE key is public and shipped to
# the browser; the SECRET must never leave the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Hostnames the widget may be solved on. Defaults to BASE_URL's host; add others comma-separated.
TURNSTILE_ALLOWED_HOSTNAMES=
# Emergency only: 1 = allow requests through when Cloudflare's siteverify is unreachable.
# Default (unset) rejects, per Cloudflare guidance.
TURNSTILE_FAIL_OPEN=
# Contact-form submissions allowed per IP per hour (default 5). Raise only for test runs.
CONTACT_RATE_LIMIT=
# Landing-page demo events per IP per 15 min (default 15). Raise it on a test stack.
DEMO_RATE_LIMIT=

# Video length. An event's purchased videoSeconds is a PRICE tier (10s/30s/60s/90s), not a technical
# limit: over-length clips are kept, because a guest filming the speeches cannot re-trim them later.
# VIDEO_GRACE_SECONDS > 0 caps how far past the purchased limit you accept (0 = no cap, the default).
# VIDEO_HARD_MAX_SECONDS is the absolute ceiling — a storage guard, not a pricing gate.
# Buying video at all is still required; an event with no video add-on refuses video uploads outright.
VIDEO_GRACE_SECONDS=
VIDEO_HARD_MAX_SECONDS=

# Rate limits (per IP). Defaults: auth 40/15m, login 15/15m, /api 600/60s, contact 5/hr.
# Raise ONLY for automated test runs.
AUTH_RATE_LIMIT=
LOGIN_RATE_LIMIT=
API_RATE_LIMIT=
EMAIL_RATE_LIMIT=
# Write-behind flush interval for gallery counters (ms, default 5000). Lower it for test runs.
COUNTER_FLUSH_MS=

# Host thank-you reward, issued with the post-event feedback email for PAID, unrefunded events only.
# Single-use Stripe promotion code (THANKS######). Keep the percentage at or above any public
# discount you advertise — a reward worth less than a code anyone can find is not a reward.
HOST_REWARD_PERCENT=
HOST_REWARD_DAYS=
