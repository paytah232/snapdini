# Dependencies
node_modules/
**/node_modules/

# Secrets / local env — NEVER commit (.env.example is the only tracked one)
.env
.env.*
!.env.example

# Local data — Postgres + uploaded media (dev AND prod). Contains real data + secrets.
data/
data-prod/
app/data/
app/data-prod/

# Build artifacts
web/build/
web/.svelte-kit/
**/*.timestamp-*.mjs

# Test output
test-results/
playwright-report/

# OS
.DS_Store

# Agent / maintainer-internal notes (not part of the product)
CLAUDE.md
**/CLAUDE.md

# Reference material dropped into docs/ for analysis — reels, screen recordings, screenshots of
# other people's apps. This is a PUBLIC repo: none of it belongs in history, and it is the kind of
# thing `git add -A` sweeps up silently. The genuine video fixtures live in loadtest/ and stay
# tracked, which is why this is scoped to docs/ rather than a blanket *.mp4.
/docs/*.mp4
# Design references gathered from other people's products (Etsy listings, mockups, competitor
# signage). Third-party artwork we do not own and must never republish — this is a PUBLIC repo, so
# committing them would be redistributing someone else's work under our licence.
/docs/themes/
/docs/*.mov
/docs/*.m4v
/docs/*.webm
/docs/reel-frames/

# scratch fixtures written by test runs
/testsuite/tmp/

# scratch browser harness for camera work (not a deliverable)
/web/.camtest/

# Google Search Console ownership token for the DEV host
# (snapdini-dev.pugno-nas.synology.me). Deliberately untracked rather than committed: devel builds
# its image from this working tree, so the file is served there, while production pulls a ghcr
# image built by CI from the repo — which will never contain it. That keeps a dev-only verification
# token off the production domain and out of a public repo, without any conditional serving.
# It must stay in place: Search Console re-checks ownership periodically. If devel is ever rebuilt
# from a fresh clone this file will be missing and the property will fail verification — recreate it
# with the one line Google expects, and nothing else.
/web/static/google*.html
